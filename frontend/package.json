{
  "name": "erp-consulvolt-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verificar-tipos": "tsc -b --noEmit",
    "testes": "vitest run",
    "pre-visualizar": "vite preview",
    "e2e": "playwright test",
    "e2e:relatorio": "playwright show-report playwright-report",
    "e2e:preparar": "docker compose -f ../docker-compose.yml -f ../docker-compose.e2e.yml exec -T app_e2e php artisan erp:e2e:preparar --force",
    "e2e:tipos": "tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@tanstack/react-query": "^5.62.0",
    "antd": "^5.22.5",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
