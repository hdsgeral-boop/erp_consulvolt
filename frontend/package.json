{
  "name": "erp-consulvolt-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verificar-tipos": "tsc -b --noEmit",
    "testes": "vitest run",
    "pre-visualizar": "vite preview",
    "e2e": "playwright test",
    "e2e:relatorio": "playwright show-report playwright-report",
    "e2e:preparar": "docker compose -f ../docker-compose.yml -f ../docker-compose.e2e.yml exec -T app_e2e php artisan erp:e2e:preparar --force",
    "e2e:tipos": "tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.1",
    "antd": "^6.6.8",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
