APP_NAME="ERP Consulvolt"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Luanda

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Base de dados: DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD vêm do docker-compose (variáveis reais prevalecem).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp_consulvolt

# Cache, filas e sessão em Redis. Chaves de cache: erp:{empresa_id}:{modulo}:{chave}
CACHE_STORE=redis
CACHE_PREFIX=erp:
REDIS_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@consulvolt.ao"
MAIL_FROM_NAME="${APP_NAME}"

# Sessão da API (paridade com o legado: logout por inactividade aos 15 minutos)
ERP_SESSAO_INATIVIDADE_MINUTOS=15
ERP_SESSAO_VALIDADE_HORAS=12
