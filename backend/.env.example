APP_NAME="ERP Consulvolt"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Luanda

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Base de dados: DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD vêm do docker-compose (variáveis reais prevalecem).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp_consulvolt

# Cache, filas e sessão em Redis. Chaves de cache: erp:{empresa_id}:{modulo}:{chave}
CACHE_STORE=redis
CACHE_PREFIX=erp:
REDIS_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@consulvolt.ao"
MAIL_FROM_NAME="${APP_NAME}"

# Sessão da API (paridade com o legado: logout por inactividade aos 15 minutos)
ERP_SESSAO_INATIVIDADE_MINUTOS=15
ERP_SESSAO_VALIDADE_HORAS=12

# Facturação electrónica AGT (ADR-030). As credenciais ficam SÓ aqui (nunca na base de dados nem no browser);
# as chaves PEM ficam na pasta montada em /run/segredos/agt (AGT_PASTA_SEGREDOS no .env da raiz; fora do Git).
AGT_DRIVER=desligado            # desligado | direto | intermedio
AGT_AMBIENTE=homologacao        # homologacao | producao (só depois de homologado)
AGT_UTILIZADOR=
AGT_PALAVRA_PASSE=
AGT_PRODUCT_ID=
AGT_PRODUCT_VERSION=
AGT_SOFTWARE_VALIDATION=
AGT_PRODUTOR_NIF=
AGT_JWS_TYP=JWT
AGT_VERSAO_CHAVE_SAFT=1
# Só com AGT_DRIVER=intermedio (serviço servico_agt do legado)
AGT_INTERMEDIO_URL=
AGT_INTERMEDIO_TOKEN=
