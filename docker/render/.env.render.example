# Modelo para testar a imagem Render localmente (docker run --env-file docker/render/.env.render ...).
# Copiar para docker/render/.env.render (ignorado pelo Git) e preencher. No painel da Render as variáveis
# vêm do render.yaml + as marcadas com «sync: false».
APP_KEY=
APP_URL=http://localhost:10000
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.SUBSTITUIR_project_ref
DB_PASSWORD=
DB_SSLMODE=require
CACHE_STORE=file
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
ERP_CORS_ORIGENS=http://localhost:5173
AGT_DRIVER=desligado
MAIL_MAILER=log
LOG_CHANNEL=stderr
PORT=10000
ERP_MIGRAR_NO_ARRANQUE=1
ERP_SCHEDULER=false
