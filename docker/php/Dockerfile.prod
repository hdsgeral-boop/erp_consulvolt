# syntax=docker/dockerfile:1.7
#
# ERP_CONSULVOLT — imagens de PRODUÇÃO (multi-stage, um único Dockerfile para garantir que backend,
# frontend e ferramentas de cópia saem do MESMO commit).
#
#   Alvo   | Imagem                         | Serviços (docker-compose.prod.yml)
#   -------+--------------------------------+-----------------------------------
#   app    | PHP 8.3-FPM + código + vendor  | app, worker, scheduler   (alvo por omissão)
#   web    | nginx sem root + frontend/dist | web
#   copias | PostgreSQL 16 client + openssl | copias (backup agendado)
#
# Construção (contexto = raiz do repositório; o .dockerignore exclui segredos, dados e dependências):
#   docker build -f docker/php/Dockerfile.prod --target app    --build-arg ERP_VERSAO=$(git describe --always) -t erp_consulvolt/app:<versao> .
#   docker build -f docker/php/Dockerfile.prod --target web    -t erp_consulvolt/web:<versao> .
#   docker build -f docker/php/Dockerfile.prod --target copias -t erp_consulvolt/copias:<versao> .
# (ou simplesmente: docker compose -f docker-compose.prod.yml --env-file .env.prod build)
#
# Nenhum segredo entra nas imagens: APP_KEY, palavras-passe e chaves AGT chegam só em tempo de execução.

ARG PHP_IMAGEM=php:8.3-fpm-alpine
ARG NODE_IMAGEM=node:22-alpine
ARG NGINX_IMAGEM=nginxinc/nginx-unprivileged:1.27-alpine
ARG POSTGRES_IMAGEM=postgres:16-alpine

# ---------------------------------------------------------------------------------------------
# 1. Frontend: npm ci + build (tsc -b && vite build) -> /src/frontend/dist
# ---------------------------------------------------------------------------------------------
FROM ${NODE_IMAGEM} AS frontend
WORKDIR /src/frontend
ENV CI=true NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false NPM_CONFIG_UPDATE_NOTIFIER=false
COPY frontend/package.json frontend/package-lock.json ./
# O esbuild precisa do seu script de instalação (descarrega/valida o binário da plataforma):
# --ignore-scripts=false garante-o também com versões do npm que bloqueiam scripts por omissão.
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts=false
COPY frontend/ ./
RUN npm run build && test -f dist/index.html

# ---------------------------------------------------------------------------------------------
# 2. Base PHP: extensões iguais às do Dockerfile de desenvolvimento, sem ferramentas de build
# ---------------------------------------------------------------------------------------------
FROM ${PHP_IMAGEM} AS php-base
RUN apk add --no-cache icu-libs libzip libpq libpng tzdata fcgi \
 && apk add --no-cache --virtual .deps-build $PHPIZE_DEPS icu-dev libzip-dev libpng-dev postgresql-dev linux-headers \
 && docker-php-ext-install -j"$(nproc)" pdo_pgsql pgsql intl zip bcmath opcache pcntl gd \
 && pecl install redis \
 && docker-php-ext-enable redis \
 && apk del .deps-build \
 && rm -rf /tmp/pear /usr/src/php.tar.* /var/cache/apk/*
ENV TZ=Africa/Luanda

# ---------------------------------------------------------------------------------------------
# 3. Dependências PHP: composer install --no-dev --optimize-autoloader + caches de rotas/eventos
# ---------------------------------------------------------------------------------------------
FROM php-base AS vendor
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_NO_INTERACTION=1
# Tem de ser o MESMO caminho da imagem final: a cache de rotas guarda caminhos absolutos (ex.: a vista do /up).
WORKDIR /var/www/html
COPY backend/composer.json backend/composer.lock ./
RUN --mount=type=cache,target=/root/.composer/cache \
    composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-progress
COPY backend/ ./
# Ficheiros só de desenvolvimento/testes não vão para produção.
RUN rm -rf tests phpunit.xml phpunit_b.xml package.json vite.config.js README.md .env.example \
 && composer dump-autoload --no-dev --optimize \
 && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan route:cache --no-ansi \
 && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan event:cache --no-ansi \
 && rm -f bootstrap/cache/config.php \
 && test -f bootstrap/cache/routes-v7.php && test -f bootstrap/cache/events.php

# ---------------------------------------------------------------------------------------------
# 4. Ferramentas de cópia de segurança (serviço copias): pg_dump/pg_restore 16 + openssl
# ---------------------------------------------------------------------------------------------
FROM ${POSTGRES_IMAGEM} AS copias
RUN apk add --no-cache openssl
COPY --chmod=755 ferramentas/operacao/ /operacao/
ENV TZ=Africa/Luanda
ENTRYPOINT []
CMD ["/operacao/copias-agendadas.sh"]

# ---------------------------------------------------------------------------------------------
# 5. Web: nginx sem root (porta 8080) com o frontend construído e os cabeçalhos de segurança
# ---------------------------------------------------------------------------------------------
FROM ${NGINX_IMAGEM} AS web
COPY docker/nginx/producao/00-http.conf /etc/nginx/conf.d/00-http.conf
COPY docker/nginx/producao/erp.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/producao/cabecalhos-seguranca.conf /etc/nginx/snippets/cabecalhos-seguranca.conf
COPY docker/nginx/producao/fastcgi-laravel.conf /etc/nginx/snippets/fastcgi-laravel.conf
COPY --from=frontend /src/frontend/dist /var/www/frontend
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/nginx-saude || exit 1

# ---------------------------------------------------------------------------------------------
# 6. App (alvo por omissão): PHP-FPM sem root, código imutável, OPcache sem revalidação
# ---------------------------------------------------------------------------------------------
FROM php-base AS app
ARG ERP_VERSAO=desconhecida
LABEL org.opencontainers.image.title="erp_consulvolt-app" \
      org.opencontainers.image.version="${ERP_VERSAO}"
ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    PHP_FPM_MAX_CHILDREN=20 \
    PHP_FPM_START_SERVERS=4 \
    PHP_FPM_MIN_SPARE=2 \
    PHP_FPM_MAX_SPARE=8
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php/producao/php.ini "$PHP_INI_DIR/conf.d/zz-erp-producao.ini"
COPY docker/php/producao/www.conf /usr/local/etc/php-fpm.d/zz-erp.conf
COPY --chmod=755 docker/php/producao/entrypoint.sh /usr/local/bin/erp-entrypoint
WORKDIR /var/www/html
# Código pertence a root e é só de leitura para o PHP; só storage/ e bootstrap/cache/ são graváveis.
COPY --from=vendor /var/www/html /var/www/html
RUN printf '%s\n' "${ERP_VERSAO}" > VERSAO \
 && mkdir -p /opt/erp/bootstrap-cache storage/app/private storage/app/public storage/logs \
             storage/framework/cache/data storage/framework/views storage/framework/sessions \
 && cp bootstrap/cache/*.php /opt/erp/bootstrap-cache/ \
 && chown root:root /var/www/html \
 && chown -R www-data:www-data storage bootstrap/cache \
 && chmod -R u=rwX,go=rX /var/www/html /opt/erp \
 && chmod -R ug+rwX storage bootstrap/cache
USER www-data
EXPOSE 9000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD SCRIPT_NAME=/fpm-ping SCRIPT_FILENAME=/fpm-ping REQUEST_METHOD=GET \
        cgi-fcgi -bind -connect 127.0.0.1:9000 | grep -q pong || exit 1
ENTRYPOINT ["erp-entrypoint"]
CMD ["php-fpm"]
