# Caddy no servidor AWS (docker-compose.aws.yml): entrada pública directa (portas 80/443), sem túnel.
#
# HTTPS a pedido para <DOMINIO_BASE> e todos os seus subdomínios: no primeiro acesso a um nome, o Caddy pergunta ao
# Laravel (/api/sistema/dominio-permitido) se é do sistema (base, www, plataforma ou slug de um cliente que existe) e
# só então obtém o certificado (Let's Encrypt), que renova sozinho. Um cliente novo não precisa de configuração.
# Requisito: DNS do domínio e de *.<domínio> a apontar para o IP do servidor. DOMINIO_BASE vem do .env da raiz.
{
	on_demand_tls {
		ask http://web/api/sistema/dominio-permitido
	}
}

(erp) {
	encode gzip
	reverse_proxy web:80
}

# HTTPS para os nomes do domínio (certificado a pedido)
https:// {
	tls {
		on_demand
	}
	import erp
}

# HTTP: os nomes do domínio passam para HTTPS; o acesso pelo IP continua em HTTP
:80 {
	@dominio host {$DOMINIO_BASE:dominio.invalid} *.{$DOMINIO_BASE:dominio.invalid}
	redir @dominio https://{host}{uri} 308
	import erp
}
