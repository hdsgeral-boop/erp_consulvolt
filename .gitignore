# Segredos
.env
.segredos/
*.pem
# Excepção: certificados públicos da CA (não são segredos) para a verificação TLS da consulta de NIF na AGT
!backend/resources/certs/agt-portal-ca.pem
backend/.env
# Dependências e artefactos
node_modules/
backend/vendor/
backend/node_modules/
frontend/node_modules/
# Build do frontend (gerado por `npm run build`) e caches do TypeScript
frontend/dist/
frontend/*.tsbuildinfo
backend/storage/*.key
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/.phpunit.result.cache
# Levantamento pesado (regenerável a partir do backup)
docs/dicionario/levantamento_colunas_legado.json
# Contém valores reais do backup (ex.: contas bancárias) — regenerável, nunca publicar
docs/dicionario/pendencias.json
ferramentas/gerador/unicidade_resultado.json
# Produção e operação (Fase 6): segredos, cópias de segurança e dumps nunca entram no Git
.env.prod
.env.*.local
copias/
backups/
*.dump
*.backup
*.sql
*.sql.gz
*.tar.gz.enc
contagem_*.txt
SHA256SUMS
wstb_payroll_backup_*.json
.versoes-implantadas

# credenciais locais do utilizador (nunca publicar)
credenciais*.txt
*credenciais*
# prompts de trabalho do utilizador (locais)
PROMPT_*.txt
