# =============================================================================================
# ERP_CONSULVOLT — variáveis de PRODUÇÃO (modelo). Copiar para .env.prod, preencher e proteger:
#     cp .env.prod.example .env.prod && chmod 600 .env.prod
# O .env.prod NUNCA entra no Git (.gitignore) nem nas imagens (.dockerignore).
# Usado de duas formas pelo docker-compose.prod.yml:
#   1) --env-file .env.prod  -> substitui as ${VARIAVEIS} do ficheiro compose (portas, imagens, credenciais);
#   2) env_file: .env.prod   -> variáveis de ambiente dos contentores app/worker/scheduler (Laravel).
# Gerar segredos fortes:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# Gerar a APP_KEY:        docker run --rm php:8.3-cli-alpine php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
# =============================================================================================

# ---------------------------------------------------------------- Compose / imagens / rede
COMPOSE_PROJECT_NAME=erp_consulvolt_prod
# Etiqueta das imagens (usar o commit ou a versão: ERP_VERSAO=$(git describe --always --tags)); aparece em /api/saude.
ERP_VERSAO=local
ERP_IMAGEM_PREFIXO=erp_consulvolt
# Endereço/porta onde o nginx do ERP fica publicado. Manter 127.0.0.1: o HTTPS é servido pelo reverse proxy do host.
WEB_ENDERECO=127.0.0.1
WEB_PORTA=8080

# ---------------------------------------------------------------- PostgreSQL (o ERP usa estas mesmas credenciais)
POSTGRES_DB=erp_consulvolt
POSTGRES_USER=erp_utilizador
POSTGRES_PASSWORD=SUBSTITUIR_por_segredo_forte
# Memória do PostgreSQL (≈25% e ≈75% da RAM dedicada à base)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB

# ---------------------------------------------------------------- Redis (cache, locks, filas, sessões)
REDIS_PASSWORD=SUBSTITUIR_por_segredo_forte

# ---------------------------------------------------------------- Aplicação Laravel
APP_NAME="ERP Consulvolt"
APP_ENV=production
APP_DEBUG=false
# Obrigatória (o arranque falha sem ela). NUNCA mudar depois de haver dados cifrados/sessões; guardar no cofre.
APP_KEY=
# Chaves anteriores (separadas por vírgula) durante uma rotação da APP_KEY
APP_PREVIOUS_KEYS=
# URL pública (HTTPS) — usada em ligações geradas pelo backend
APP_URL=https://erp.exemplo.ao
APP_TIMEZONE=Africa/Luanda
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
# Modo de manutenção partilhado entre app/worker/scheduler (php artisan down)
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- Logs (stderr em JSON -> docker logs, com rotação)
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------- Cache, filas e sessão
CACHE_STORE=redis
CACHE_PREFIX=erp:
REDIS_PREFIX=
QUEUE_CONNECTION=redis
# Tem de ser MAIOR do que o --timeout do worker (600 s); com o valor por omissão (90 s) um trabalho longo
# (folhas em massa, PDFs, AGT) seria entregue a outro worker enquanto ainda corre.
REDIS_QUEUE_RETRY_AFTER=660
# um trabalho despachado dentro de uma transacção só entra na fila depois do COMMIT (descartado no ROLLBACK) — ADR-080
QUEUE_AFTER_COMMIT=true
# API sem estado (Bearer Sanctum, sanctum.guard=[]): nenhuma rota inicia sessão; «cookie» evita chaves de sessão no Redis
# (cookie cifrado com APP_KEY, HttpOnly, SameSite; Secure em produção). Não voltar a «redis» sem ADR.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------- Imagens no Cloudflare R2 (logótipos, imagens de produtos)
# Com ERP_IMAGENS_DISCO=imagens, as imagens vão para o bucket R2 e a base guarda só o URL público (o navegador lê-as
# directamente da Cloudflare). Vazio = comportamento antigo (base64 na base / ficheiro privado no servidor).
# Depois de configurar: php artisan erp:imagens:migrar (move as imagens existentes). Ver config/filesystems.php › imagens.
ERP_IMAGENS_DISCO=
R2_BUCKET=
R2_ENDPOINT=                     # https://<account_id>.r2.cloudflarestorage.com
R2_URL_PUBLICA=                  # https://pub-<id>.r2.dev (R2 › bucket › Settings › Public access) ou domínio próprio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Autenticação (tokens Bearer Sanctum, ADR-007)
# A API usa só tokens Bearer (sem cookies de SPA): manter vazio.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=
ERP_SESSAO_INATIVIDADE_MINUTOS=15
ERP_SESSAO_VALIDADE_HORAS=12
ERP_SESSAO_TENTATIVAS_POR_MINUTO=5
ERP_SESSAO_TENTATIVAS_POR_MINUTO_IP=60
# Sessões e cookies (ADR-082) — valores por omissão; só descomentar para alterar
# ERP_COOKIE_SECURE=                    # vazio = Secure automático em HTTPS; true força (e usa o prefixo __Host-)
# ERP_COOKIE_SAMESITE=strict            # strict | lax
# ERP_SESSAO_ROTACAO_MINUTOS=10         # idade a partir da qual o token roda (0 = sem rotação)
# ERP_SESSAO_ROTACAO_TOLERANCIA_SEGUNDOS=45
# ERP_SESSAO_MAX_POR_UTILIZADOR=10      # sessões simultâneas por utilizador (0 = ilimitado)
# ERP_SESSAO_VINCULAR_AGENTE=true       # termina a sessão se mudar o navegador/sistema operativo
# ERP_SESSAO_DISPOSITIVO_DIAS=180
# ERP_SESSAO_VERIFICAR_ORIGEM=true      # Origin/Sec-Fetch-Site nos pedidos que alteram estado
# ERP_SESSAO_ORIGENS_PERMITIDAS=        # origens extra, separadas por vírgulas
# ERP_RECUPERACAO_MAX_POR_HORA=3
# ERP_RECUPERACAO_INTERVALO_SEGUNDOS=120
# ERP_RECUPERACAO_TEMPO_MINIMO_MS=1200
ERP_API_PEDIDOS_POR_MINUTO=300

# Login com o Google (AutenticacaoGoogleController, routes/web.php). GOOGLE_REDIRECT_URI tem de bater certo com o
# "Authorized redirect URI" da Google Cloud Console — https://<dominio>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------- PHP-FPM (por contentor app)
# max_children ≈ (memória do contentor app − 256 MB) / ~60 MB por processo
PHP_FPM_MAX_CHILDREN=20
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE=2
PHP_FPM_MAX_SPARE=8

# ---------------------------------------------------------------- E-mail
# O ERP regista os e-mails do CRM sem os enviar (ADR-054); "log" é suficiente até haver envio real.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responder@consulvolt.ao"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Facturação electrónica AGT (ADR-030)
# Pasta do HOST com as chaves PEM (produtor_privada.pem, saft_privada.pem, contribuintes/<NIF>.pem).
# Montada só de leitura em /run/segredos/agt. Permissões: chown -R 82:82 <pasta> && chmod 500 <pasta> && chmod 400 <pasta>/*.pem
AGT_PASTA_SEGREDOS=/srv/erp/segredos/agt
AGT_DRIVER=desligado            # desligado | direto | intermedio
AGT_AMBIENTE=homologacao        # homologacao | producao (só depois de homologado)
AGT_URL_BASE=
AGT_TIMEOUT=30
AGT_UTILIZADOR=
AGT_PALAVRA_PASSE=
AGT_PRODUCT_ID=
AGT_PRODUCT_VERSION=
AGT_SOFTWARE_VALIDATION=
AGT_PRODUTOR_NIF=
AGT_JWS_TYP=JWT
AGT_CHAVE_PRODUTOR=produtor_privada.pem
AGT_PASTA_CONTRIBUINTES=contribuintes
AGT_CHAVE_SAFT=saft_privada.pem
AGT_VERSAO_CHAVE_SAFT=1
AGT_INTERMEDIO_URL=
AGT_INTERMEDIO_TOKEN=

# ---------------------------------------------------------------- Cópias de segurança (serviço copias)
# Pasta do HOST onde ficam as cópias (fora do repositório; idealmente noutro disco) — ver docs/PRODUCAO.md.
ERP_PASTA_COPIAS=/srv/erp/copias
# Expressão cron (hora de Luanda)
ERP_COPIAS_CRON=30 2 * * *
ERP_COPIAS_AO_ARRANCAR=0
ERP_COPIAS_RETER_DIARIAS=7
ERP_COPIAS_RETER_SEMANAIS=4
ERP_COPIAS_RETER_MENSAIS=12
# Incluir os dados do Redis (filas pendentes) na cópia: /dados/redis ; vazio = não incluir
ERP_COPIAS_REDIS_DIR=
# Frase-passe que cifra as chaves AGT dentro das cópias. Vazio = as chaves NÃO são copiadas.
# Guardar também num cofre FORA do servidor (sem ela as chaves copiadas são irrecuperáveis).
ERP_COPIAS_CHAVE=

# Assistente IA para lançamentos (decisão 26, ADR do R2-G4): fornecedor Claude (Anthropic). A chave fica SÓ no servidor
# (nunca no Git, na base de dados ou no navegador). Sem chave o assistente não chama a IA (as regras internas continuam).
# Cada empresa tem de o activar (desligado por omissão). Modelo e esforço: ver docs/PRODUCAO.md.
ANTHROPIC_API_KEY=
ERP_IA_MODELO=claude-opus-5-5
ERP_IA_ESFORCO=medium
ERP_IA_TEMPO_LIMITE=120

# ---------------------------------------------------------------- SaaS (ADR-073) e integração da produção (Bloco A)
# SAAS_SIMULACAO_PAGAMENTO: liga POST /api/licenca/subscricoes/{id}/simular-confirmacao (super-administrador). Condicionado a esta
# flag e NÃO a APP_ENV: o servidor de TESTE corre com APP_ENV=production e precisa de =true; na produção real deixar false.
SAAS_SIMULACAO_PAGAMENTO=false
# Palavra-passe da role erp_app (RLS). Lida por config('erp.saas.db_app_password'); com `artisan optimize` env() fora de config/ devolve vazio.
DB_APP_PASSWORD=
# Endereços (SaaS): <slug>.<DOMINIO_BASE> = cliente; <DOMINIO_PLATAFORMA>.<DOMINIO_BASE> = área da plataforma; portal.<DOMINIO_BASE> = portal do colaborador.
# Vazio em DOMINIO_BASE = sem restrição por endereço (desenvolvimento). GET /api/sistema/dominio-permitido responde ao Caddy (TLS a pedido).
DOMINIO_BASE=
DOMINIO_PLATAFORMA=admin.erp
# Segredo opcional do primeiro acesso da plataforma (POST /api/plataforma-inicial/criar-admin, cabeçalho X-Setup-Token). Vazio = só o host protege.
PLATAFORMA_SETUP_TOKEN=
# Plano de contas modelo: id da empresa (do tenant da plataforma) cujo plano é copiado para empresas novas. Vazio = a mais antiga da plataforma.
PLANO_CONTAS_EMPRESA_MODELO=
